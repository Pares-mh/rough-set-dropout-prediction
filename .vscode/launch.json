{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "1. Quick run (1x10 CV)",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "args": ["data/data.csv", "--quick"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "2. Full run (5x10 CV)",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "args": ["data/data.csv"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "3. Rebuild tables + figures only",
      "type": "debugpy", "request": "launch",
      "module": "rsproject.report",
      "args": ["results/full"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    },
    {
      "name": "0. Test on synthetic stand-in data",
      "type": "debugpy", "request": "launch",
      "program": "${workspaceFolder}/run_all.py",
      "args": ["--synthetic", "--quick"],
      "console": "integratedTerminal", "cwd": "${workspaceFolder}"
    }
  ]
}
